# xAI Grok API key -- required for the Developer Copilot chat / reasoning features.
# Without this, every other feature (scan, parse, knowledge graph, embeddings,
# health scores, dashboard) still works; chat endpoints return a clear
# "LLM not configured" error instead of crashing.
XAI_API_KEY=

# Base URL for the Grok (xAI) OpenAI-compatible API. Only change this if xAI
# changes their endpoint, or you want to point at a different OpenAI-compatible
# provider for testing.
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# Where cloned repos / extracted zips / per-repo graph+vector data are stored.
WORKSPACE_DIR=./data/workspaces

# SQLite database file for repo metadata, scan jobs, chat history.
DATABASE_URL=sqlite:///./data/archmind.db

# Max upload size for ZIP imports, in megabytes.
MAX_UPLOAD_MB=200

# CORS origin for the Next.js frontend during local dev.
FRONTEND_ORIGIN=http://localhost:3000
